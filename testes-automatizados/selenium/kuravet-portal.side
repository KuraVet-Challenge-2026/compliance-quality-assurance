    {
      "id": "ct04-aprovar-solicitacao",
      "name": "CT-04 Aprovar solicitacao de teleconsulta",
      "commands": [
        {
          "id": "c04pLa",
          "comment": "Abre a tela de login",
          "command": "open",
          "target": "http://localhost:8080/login",
          "targets": [],
          "value": ""
        },
        {
          "id": "c04pLb",
          "comment": "Entrada: usuario tutor (pre-condicao)",
          "command": "type",
          "target": "id=username",
          "targets": [],
          "value": "tutor"
        },
        {
          "id": "c04pLc",
          "comment": "Entrada: senha tutor (pre-condicao)",
          "command": "type",
          "target": "id=password",
          "targets": [],
          "value": "tutor123"
        },
        {
          "id": "c04pLd",
          "comment": "Envia o login",
          "command": "click",
          "target": "css=form[action='/login'] button[type='submit']",
          "targets": [],
          "value": ""
        },
        {
          "id": "c04p1",
          "comment": "Pre-condicao: tutor abre o formulario de solicitacao",
          "command": "open",
          "target": "http://localhost:8080/tutor/consultas/nova",
          "targets": [],
          "value": ""
        },
        {
          "id": "c04p2",
          "comment": "Entrada: pet da carga inicial",
          "command": "select",
          "target": "id=idPet",
          "targets": [],
          "value": "value=1"
        },
        {
          "id": "c04p3",
          "comment": "Entrada: veterinaria Dra. Patricia Gomes",
          "command": "select",
          "target": "id=idVeterinario",
          "targets": [],
          "value": "value=1"
        },
        {
          "id": "c04p4g",
          "comment": "Gera uma data futura unica para esta execucao",
          "command": "storeEval",
          "target": "(function(){var d=new Date(2027,0,1);d.setDate(d.getDate()+Math.floor(Date.now()/1000)%900);return d.toISOString().slice(0,10);})()",
          "targets": [],
          "value": "dataQA"
        },
        {
          "id": "c04p4e",
          "comment": "Registra a data usada no log",
          "command": "echo",
          "target": "Data da solicitacao: ${dataQA}",
          "targets": [],
          "value": ""
        },
        {
          "id": "c04p4",
          "comment": "Entrada: data futura gerada na execucao (o sistema nao aceita duas consultas ativas do mesmo pet na mesma data)",
          "command": "type",
          "target": "id=dataConsulta",
          "targets": [],
          "value": "${dataQA}"
        },
        {
          "id": "c04p5",
          "comment": "Entrada: tipo que identifica a solicitacao deste teste",
          "command": "type",
          "target": "id=tipoConsulta",
          "targets": [],
          "value": "Teleconsulta QA - Aprovar"
        },
        {
          "id": "c04p6",
          "comment": "Envia a solicitacao",
          "command": "click",
          "target": "css=form[action='/tutor/consultas'] button[type='submit']",
          "targets": [],
          "value": ""
        },
        {
          "id": "c04p7",
          "comment": "Aguarda a confirmacao",
          "command": "waitForElementPresent",
          "target": "css=.aviso-sucesso",
          "targets": [],
          "value": "10000"
        },
        {
          "id": "c04p8",
          "comment": "Pre-condicao atendida: solicitacao criada",
          "command": "assertElementPresent",
          "target": "css=.aviso-sucesso",
          "targets": [],
          "value": ""
        },
        {
          "id": "c04p9",
          "comment": "Encerra a sessao",
          "command": "click",
          "target": "css=form[action='/logout'] button[type='submit']",
          "targets": [],
          "value": ""
        },
        {
          "id": "c04p9w",
          "comment": "Aguarda a tela de login",
          "command": "waitForElementPresent",
          "target": "id=username",
          "targets": [],
          "value": "10000"
        },
        {
          "id": "c04va",
          "comment": "Abre a tela de login",
          "command": "open",
          "target": "http://localhost:8080/login",
          "targets": [],
          "value": ""
        },
        {
          "id": "c04vb",
          "comment": "Entrada: usuario veterinario",
          "command": "type",
          "target": "id=username",
          "targets": [],
          "value": "veterinario"
        },
        {
          "id": "c04vc",
          "comment": "Entrada: senha veterinario",
          "command": "type",
          "target": "id=password",
          "targets": [],
          "value": "vet123"
        },
        {
          "id": "c04vd",
          "comment": "Envia o login",
          "command": "click",
          "target": "css=form[action='/login'] button[type='submit']",
          "targets": [],
          "value": ""
        },
        {
          "id": "c0401",
          "comment": "Abre a fila de solicitacoes",
          "command": "open",
          "target": "http://localhost:8080/portal/solicitacoes",
          "targets": [],
          "value": ""
        },
        {
          "id": "c0402",
          "comment": "Entrada: solicitacao criada pelo tutor esta na fila",
          "command": "assertElementPresent",
          "target": "xpath=//tr[td[normalize-space()='Teleconsulta QA - Aprovar']]",
          "targets": [],
          "value": ""
        },
        {
          "id": "c0403",
          "comment": "Abre o detalhe da solicitacao",
          "command": "click",
          "target": "xpath=//tr[td[normalize-space()='Teleconsulta QA - Aprovar']]//a[contains(@href,'/portal/consultas/')]",
          "targets": [],
          "value": ""
        },
        {
          "id": "c0404",
          "comment": "Confere o status inicial",
          "command": "assertText",
          "target": "css=.selo",
          "targets": [],
          "value": "SOLICITADA"
        },
        {
          "id": "c0405",
          "comment": "Aprova e agenda o atendimento",
          "command": "click",
          "target": "css=form[action*='/aprovar'] button[type='submit']",
          "targets": [],
          "value": ""
        },
        {
          "id": "c0406",
          "comment": "Aguarda a volta para a fila",
          "command": "waitForElementPresent",
          "target": "css=.aviso-sucesso",
          "targets": [],
          "value": "10000"
        },
        {
          "id": "c0407",
          "comment": "Saida esperada: confirmacao da aprovacao",
          "command": "assertText",
          "target": "css=.aviso-sucesso",
          "targets": [],
          "value": "Teleconsulta de Thor aprovada e agendada."
        },
        {
          "id": "c0408",
          "comment": "Saida esperada: solicitacao sai da fila de pendentes",
          "command": "assertElementNotPresent",
          "target": "xpath=//tr[td[normalize-space()='Teleconsulta QA - Aprovar']]",
          "targets": [],
          "value": ""
        },
        {
          "id": "c0409",
          "comment": "Abre as consultas agendadas",
          "command": "open",
          "target": "http://localhost:8080/portal/consultas?status=AGENDADA",
          "targets": [],
          "value": ""
        },
        {
          "id": "c0410",
          "comment": "Saida esperada: consulta aparece como AGENDADA",
          "command": "assertElementPresent",
          "target": "xpath=//tr[td[normalize-space()='Teleconsulta QA - Aprovar']]",
          "targets": [],
          "value": ""
        }
      ]
    },
