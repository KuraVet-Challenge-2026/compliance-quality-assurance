{
  "id": "8f3a1c20-5b7e-4d61-9a2f-kuravetqa0001",
  "version": "2.0",
  "name": "KuraVet - Portal Web",
  "url": "http://localhost:8080",
  "tests": [
    {
      "id": "ct01-login-veterinario",
      "name": "CT-01 Login do veterinario com credenciais validas",
      "commands": [
        {
          "id": "c0101",
          "comment": "Abre a tela de login do portal",
          "command": "open",
          "target": "http://localhost:8080/login",
          "targets": [],
          "value": ""
        },
        {
          "id": "c0102",
          "comment": "Padroniza a janela para a gravacao",
          "command": "setWindowSize",
          "target": "1280x800",
          "targets": [],
          "value": ""
        },
        {
          "id": "c0103",
          "comment": "Confere que a tela de login carregou",
          "command": "assertElementPresent",
          "target": "id=username",
          "targets": [],
          "value": ""
        },
        {
          "id": "c0104",
          "comment": "Entrada: usuario de teste da carga inicial",
          "command": "type",
          "target": "id=username",
          "targets": [],
          "value": "veterinario"
        },
        {
          "id": "c0105",
          "comment": "Entrada: senha do usuario de teste",
          "command": "type",
          "target": "id=password",
          "targets": [],
          "value": "vet123"
        },
        {
          "id": "c0106",
          "comment": "Envia o formulario",
          "command": "click",
          "target": "css=button[type='submit']",
          "targets": [],
          "value": ""
        },
        {
          "id": "c0107",
          "comment": "Aguarda o redirecionamento por perfil",
          "command": "waitForElementPresent",
          "target": "css=a[href='/portal/solicitacoes']",
          "targets": [],
          "value": "10000"
        },
        {
          "id": "c0108",
          "comment": "Saida esperada: area da clinica disponivel",
          "command": "assertElementPresent",
          "target": "css=a[href='/portal/consultas']",
          "targets": [],
          "value": ""
        },
        {
          "id": "c0109",
          "comment": "Saida esperada: sessao ativa com opcao de sair",
          "command": "assertElementPresent",
          "target": "css=form[action='/logout'] button[type='submit']",
          "targets": [],
          "value": ""
        },
        {
          "id": "c0110",
          "comment": "Encerra a sessao",
          "command": "click",
          "target": "css=form[action='/logout'] button[type='submit']",
          "targets": [],
          "value": ""
        },
        {
          "id": "c0111",
          "comment": "Aguarda a volta para o login",
          "command": "waitForElementPresent",
          "target": "css=.aviso-sucesso",
          "targets": [],
          "value": "10000"
        },
        {
          "id": "c0112",
          "comment": "Saida esperada: sessao encerrada",
          "command": "assertText",
          "target": "css=.aviso-sucesso",
          "targets": [],
          "value": "Sessão encerrada com segurança."
        }
      ]
    },
    {
      "id": "ct02-login-invalido",
      "name": "CT-02 Login com senha incorreta e bloqueio de acesso",
      "commands": [
        {
          "id": "c0201",
          "comment": "Abre a tela de login do portal",
          "command": "open",
          "target": "http://localhost:8080/login",
          "targets": [],
          "value": ""
        },
        {
          "id": "c0202",
          "comment": "Padroniza a janela para a gravacao",
          "command": "setWindowSize",
          "target": "1280x800",
          "targets": [],
          "value": ""
        },
        {
          "id": "c0203",
          "comment": "Entrada: usuario valido",
          "command": "type",
          "target": "id=username",
          "targets": [],
          "value": "veterinario"
        },
        {
          "id": "c0204",
          "comment": "Entrada invalida: senha incorreta",
          "command": "type",
          "target": "id=password",
          "targets": [],
          "value": "senhaerrada"
        },
        {
          "id": "c0205",
          "comment": "Envia o formulario",
          "command": "click",
          "target": "css=button[type='submit']",
          "targets": [],
          "value": ""
        },
        {
          "id": "c0206",
          "comment": "Aguarda o aviso de erro",
          "command": "waitForElementPresent",
          "target": "css=.aviso-erro",
          "targets": [],
          "value": "10000"
        },
        {
          "id": "c0207",
          "comment": "Saida esperada: mensagem de credenciais invalidas",
          "command": "assertText",
          "target": "css=.aviso-erro",
          "targets": [],
          "value": "Usuário ou senha inválidos."
        },
        {
          "id": "c0208",
          "comment": "Saida esperada: segue na tela de login, sem acesso",
          "command": "assertElementPresent",
          "target": "id=username",
          "targets": [],
          "value": ""
        }
      ]
    },
